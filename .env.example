# Stripe — https://dashboard.stripe.com/apikeys (use sk_test_… while testing)
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret of the webhook endpoint https://YOUR-DOMAIN/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL of the shop, used for Stripe redirects and SEO (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yiasemi-shop.vercel.app

# Optional: e-mail the shop about every paid order (https://resend.com)
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
ORDER_FROM_EMAIL=Yiasemi <orders@your-domain.gr>
